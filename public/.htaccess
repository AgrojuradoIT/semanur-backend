<IfModule mod_rewrite.c>
    RewriteEngine On

    # Never serve APKs or operational evidence through the public storage
    # symlink. They are streamed by authorized/rate-limited API endpoints.
    RewriteRule ^storage/(?:apks|media)(?:/|$) - [F,L,NC]

    # Image caching - 1 year for vehicle photos
    <IfModule mod_expires.c>
        ExpiresActive On
        <FilesMatch "\.(webp|jpg|jpeg|png|gif|svg)$">
            ExpiresDefault "access plus 1 year"
            Header set Cache-Control "public, immutable"
        </FilesMatch>
    </IfModule>

    # If mod_expires is not available, use Cache-Control header
    <IfModule mod_headers.c>
        <FilesMatch "\.(webp|jpg|jpeg|png|gif|svg)$">
            Header set Cache-Control "public, max-age=31536000, immutable"
        </FilesMatch>
    </IfModule>

    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} (.+)/$
    RewriteRule ^ %1 [L,R=301]

    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.php [L]
</IfModule>

# Defense in depth: index.php is the only executable PHP entry point.
<IfModule mod_authz_core.c>
    <FilesMatch "\.php$">
        Require all denied
    </FilesMatch>
    <Files "index.php">
        Require all granted
    </Files>

    <FilesMatch "(^\.|\.(?:zip|tar|tgz|gz|7z|rar|sql|sqlite|bak|backup|old|log)$)">
        Require all denied
    </FilesMatch>
</IfModule>

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "DENY"
    Header always set Referrer-Policy "no-referrer"
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
    Header always set Strict-Transport-Security "max-age=31536000"
</IfModule>

Options -Indexes
