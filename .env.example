APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_SECURE_COOKIE=false
SESSION_PATH=/
SESSION_DOMAIN=null

# Optional local/testing demo seeder credential. If blank, a strong random
# password is printed once when demo users are created. Seeders reject production.
SEED_USER_PASSWORD=

# API bearer tokens expire after 24 hours by default. Use a shorter value for
# higher-risk deployments; clients refresh explicitly.
SANCTUM_EXPIRATION_MINUTES=1440
SANCTUM_TOKEN_PREFIX=semanur_

# Exact browser origins only; never use * in production.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Mobile release identity/integrity fallback. DB-backed active versions take
# precedence and are verified when uploaded/activated.
APP_VERSION_PACKAGE_NAME=com.semanur.hub
APP_VERSION_APK_SHA256=
APP_VERSION_APK_SIZE_BYTES=
APP_VERSION_SIGNER_SHA256=

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Inventory imports (bodega is required unless this explicit default is set)
INVENTORY_DEFAULT_BODEGA_ID=
INVENTORY_REQUIRE_CLIENT_OPERATION_ID=false
INVENTORY_IMPORT_MAX_FILE_KB=5120
INVENTORY_IMPORT_MAX_ROWS=5000
INVENTORY_IMPORT_MAX_UNCOMPRESSED_BYTES=33554432
INVENTORY_IMPORT_MAX_ZIP_ENTRIES=256
INVENTORY_IMPORT_HEADER_SCAN_ROWS=100
INVENTORY_IMPORT_MAX_COLUMNS=64

# Firebase Cloud Messaging (FCM)
# OPCION 1 (Mas segura para cPanel): Convertir el JSON descargado a Base64 y pegarlo aqui:
FIREBASE_CREDENTIALS_BASE64=
# OPCION 2 (Archivo fisico): Subir el archivo JSON a storage/app/secret/ (NUNCA en public/) y poner la ruta:
FIREBASE_CREDENTIALS=storage/app/secret/firebase_credentials.json

# Google Cloud Vision OCR (modulo de pedidos con OCR)
# La clave NUNCA va en el repo: solo se configura la RUTA en tu .env local
# (.env esta ignorado por git). Las rutas relativas se resuelven contra la
# raiz del proyecto, asi que el ejemplo de abajo funciona tal cual.
# 1) Crea una service account con el rol minimo (Cloud Vision User) en tu
#    proyecto GCP con Vision API + facturacion habilitadas.
# 2) Descarga su JSON y guardalo AQUI (permisos 0600, NUNCA en public/):
#      backend/storage/app/secret/semanur-vision-key.json
# 3) En tu .env local pone:
#      GOOGLE_APPLICATION_CREDENTIALS=storage/app/secret/semanur-vision-key.json
#      GOOGLE_CLOUD_PROJECT=tu-proyecto-gcp
#      INVENTORY_ORDERS_OCR_PROVIDER=google
#      INVENTORY_ORDERS_OCR_GOOGLE_ENABLED=true
# Sin esto, el proveedor google falla cerrado (proveedor_no_habilitado, cero
# red) y el sistema sigue usando el fake.
GOOGLE_APPLICATION_CREDENTIALS=
GOOGLE_CLOUD_PROJECT=
INVENTORY_ORDERS_OCR_PROVIDER=fake
INVENTORY_ORDERS_OCR_GOOGLE_ENABLED=false
